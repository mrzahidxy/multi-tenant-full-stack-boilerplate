# Project metadata (template placeholders)
APP_NAME="Pern Boilerplate API"
APP_DESCRIPTION="Pern Boilerplate API with auth, RBAC, and sample modules."
JWT_ISSUER=pern-boilerplate

# Server
PORT=8080
HOST=0.0.0.0
NODE_ENV=development
TRUST_PROXY=false

# Database (non-Docker app run; points to host Postgres)
DATABASE_URL="postgresql://app_user:app_password@localhost:5433/app_db?schema=public"
DIRECT_URL="postgresql://app_user:app_password@localhost:5433/app_db?schema=public"

# Docker Compose database defaults
POSTGRES_DB=app_db
POSTGRES_USER=app_user
POSTGRES_PASSWORD=app_password
DB_PORT=5433

# Redis (required in production for durable auth/session revocation)
REDIS_URL=

# JWT
JWT_SECRET="change-this-to-a-strong-secret-with-at-least-16-characters"
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=7
REFRESH_TOKEN_COOKIE_NAME=refreshToken
REFRESH_TOKEN_COOKIE_PATH=/api
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
JWT_AUDIENCE=

# CORS (list explicit origins; wildcards are rejected in production)
CORS_ORIGIN="http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173"

# Stripe (optional)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_CURRENCY=usd

# Cloudinary (optional)
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# Client URL (optional)
CLIENT_URL="http://localhost:5173"

# Upload
MAX_UPLOAD_SIZE=5242880
